# CI/CD Build Environment Variables
# Used during GitHub Actions CI build (not for runtime)

PORT=8080
NODE_ENV=production

# Dummy values for build-time (not used in CI)
MONGO_URL=mongodb://placeholder:placeholder@localhost/sibernote
JWT_KEY=dummy_jwt_key_for_build_only_do_not_use_in_production
REFRESH_TOKEN_KEY=dummy_refresh_key_for_build_only_do_not_use_in_production
UPLOAD_BASE_URL=http://localhost:8080/uploads
UPLOADS_DIR=./uploads
GEMINI_EMBEDDING_KEY=dummy_gemini_key_for_build_only
