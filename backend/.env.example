# Salin file ini menjadi .env lalu isi nilainya.

# MongoDB connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>

# Port server (default 8080)
PORT=8080

# JSON Web Token secrets
JWT_KEY=ganti_dengan_secret_yang_kuat
REFRESH_TOKEN_KEY=ganti_dengan_secret_refresh_yang_kuat

# ── Upload ke VPS lokal ────────────────────────────────────────────────────────
# URL publik yang digunakan FE untuk mengakses file (tanpa trailing slash).
# Harus sesuai dengan domain/IP VPS + path yang di-serve Express.
# Contoh produksi:  https://api.yourdomain.com/uploads
# Contoh lokal:     http://localhost:8080/uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

# Path absolut di VPS tempat file disimpan.
# Pastikan user yang menjalankan Node punya write permission ke folder ini.
# Contoh produksi:  /var/www/sibernote/uploads
# Contoh Docker:    /app/uploads  (mount volume ke sini)
# Contoh lokal:     ./uploads
UPLOADS_DIR=./uploads

# Google Gemini API key (untuk embedding)
GEMINI_EMBEDDING_KEY=your_gemini_api_key
